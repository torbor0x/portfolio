# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives Contact Me. This value stays off the website.
CONTACT_TO=
# Optional. Until a domain is verified in Resend, leave this unset.
# The default sender is Portfolio <onboarding@resend.dev>, which can only
# deliver to the inbox on the Resend account.
CONTACT_FROM=
